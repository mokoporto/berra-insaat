{
  "name": "berra-insaat",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "berrayapi.com", "custom_domain": true },
    { "pattern": "www.berrayapi.com", "custom_domain": true }
  ]
}
