{
  "name": "berra-insaat",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "berrayapi.com", "custom_domain": true },
    { "pattern": "www.berrayapi.com", "custom_domain": true }
  ]
}
